# Copy to config.env (git-ignored) and fill in. No secrets here.

# Forge: github or gitlab. Access: cli, or mcp:<server name>.
FORGE=github
FORGE_ACCESS=cli

# Ticket tracker: jira, linear, github, gitlab, or none.
# Access: cli, or mcp:<server name>. Prefixes: KEY=tracker pairs, comma separated.
TRACKER=none
TRACKER_ACCESS=
TICKET_PREFIXES=

# Docs and chat sources: confluence, notion, slack, and so on, or none.
DOCS_SOURCE=none
DOCS_ACCESS=
CHAT_SOURCE=none
CHAT_ACCESS=

# Ticket status to move to once the PR is open. Empty means leave the status alone.
TICKET_STATUS_AFTER_PR=

# Tiers map to real model names for the harness in use. Empty means the harness default.
TIER_CHEAP=
TIER_STANDARD=
TIER_STRONG=

# Caps.
CAP_TASK_CHEAP_ATTEMPTS=2
CAP_TASK_STANDARD_ATTEMPTS=1
CAP_VERIFY_ROUNDS=3
CAP_REVIEW_ROUNDS=2

# CI check: seconds to wait for checks to appear, and minutes to wait for them to finish.
CI_GRACE_SECONDS=90
CI_WAIT_MINUTES=20

# Branch naming (used by the branch phase)
# Placeholders: {username} {type} {ticket} {slug}
BRANCH_TEMPLATE={username}/{type}/{ticket}-{slug}

# Empty means use the login of the forge account.
BRANCH_USERNAME=

BRANCH_SLUG_MAX=40

# Where worktrees go. Empty means ../<repo>.worktrees
WORKTREE_DIR=

# Ticket type to branch type, comma separated.
TYPE_MAP=bug=fix,story=feat,feature=feat,task=chore,improvement=feat,chore=chore,docs=docs,test=test,build=build
