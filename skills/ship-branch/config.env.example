# Copy to config.env (git-ignored).

# Placeholders: {username} {type} {ticket} {slug}
BRANCH_TEMPLATE={username}/{type}/{ticket}-{slug}

# Empty means use the login of the forge account.
BRANCH_USERNAME=

BRANCH_SLUG_MAX=40

# Where worktrees go. Empty means ../<repo>.worktrees
WORKTREE_DIR=

# Ticket type to branch type, comma separated.
TYPE_MAP=bug=fix,story=feat,feature=feat,task=chore,improvement=feat,chore=chore,docs=docs,test=test,build=build
